# Copia este archivo a .env (nunca subas el .env). Valores para docker compose local.
PORT=8000
HOST=127.0.0.1
# Usuario de SOLO LECTURA: reportes nunca escribe datos de negocio (constitución, principio VI).
REPORTS_DATABASE_URL=postgresql://reportes_lectura:reportes_local@localhost:5432/apuestas
WEB_ORIGIN=http://localhost:3000

# Solo para tests/test_solo_lectura.py: el dueño de las tablas crea una tabla de prueba.
PRUEBAS_DATABASE_URL_PROPIETARIO=postgresql://apuestas:apuestas_local@localhost:5432/apuestas
