# Copia este archivo a .env (nunca subas el .env). Valores para docker compose local.
PORT=8000
HOST=127.0.0.1
# Usuario de SOLO LECTURA: reportes nunca escribe datos de negocio (constitución, principio VI).
REPORTS_DATABASE_URL=postgresql://reportes_lectura:reportes_local@localhost:5432/apuestas
WEB_ORIGIN=http://localhost:3000

# Token de acceso de la API (contrato 6). Reportes solo VERIFICA: nunca tiene la clave privada.
# Obligatoria: clave pública PEM en una línea, con los saltos como \n. En local, mientras el Spec 2 no emita
# tokens, genera un par de prueba con `uv run python -m reports.herramientas.clave_dev`.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<pega aquí la clave>\n-----END PUBLIC KEY-----
# EdDSA (Ed25519) o RS256: el mismo con el que firme la API.
JWT_ALGORITHM=EdDSA
JWT_ISSUER=apuestas-api
JWT_AUDIENCE=apuestas

# Solo para tests/test_solo_lectura.py: el dueño de las tablas crea una tabla de prueba.
PRUEBAS_DATABASE_URL_PROPIETARIO=postgresql://apuestas:apuestas_local@localhost:5432/apuestas
