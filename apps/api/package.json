{
  "name": "api",
  "version": "0.1.0",
  "description": "API principal (NestJS): dueña del dinero, las apuestas y la liquidación",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage && vitest run --config ./vitest.config.e2e.ts --coverage",
    "test:unit": "vitest run",
    "test:int": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest",
    "seed:partidos": "tsx scripts/seed-partidos.ts"
  },
  "dependencies": {
    "@apuestas/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.7.6",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
