# Copia este archivo a .env (nunca subas el .env). Valores para docker compose local.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://apuestas:apuestas_local@localhost:5432/apuestas
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
# Proxies de confianza delante de la API (0 en local, 1 en Render).
TRUST_PROXY_HOPS=0
