# Copia este archivo a .env (nunca subas el .env). Valores para docker compose local.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://apuestas:apuestas_local@localhost:5432/apuestas
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
# Proxies de confianza delante de la API (0 en local, 1 en Render).
TRUST_PROXY_HOPS=0

# --- Spec 2: identidad y sesión ---
# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, TOTP_CLAVE_CIFRADO y WEB_PROXY_SECRETO se generan, no se copian.
# Desde la raíz del repo (agrega las cuatro líneas al final de este .env):
#   pnpm --filter api exec tsx scripts/generar-secretos.ts >> apps/api/.env
# WEB_PROXY_SECRETO debe ser el mismo en apps/web/.env.local.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# En local por HTTP; en staging y producción siempre true.
COOKIE_SECURE=false
# Secreto de prueba de Cloudflare Turnstile: aprueba siempre. Nunca en producción.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15

# --- Spec 2: correo (Mailpit de docker compose; bandeja en http://localhost:8025) ---
CORREO_TRANSPORTE=smtp
SMTP_URL=smtp://localhost:1025
CORREO_REMITENTE=Apuestas <no-responder@localhost>

# Solo pruebas de integración: comprueban que reportes_lectura no lee las credenciales (FR-064).
REPORTS_DATABASE_URL=postgresql://reportes_lectura:reportes_local@localhost:5432/apuestas

# --- Spec 2: Payphone (sandbox). Sin token, los depósitos responden que no están disponibles. ---
# Token y storeId de la app de Payphone Developer (modo de pruebas). Nunca en el repositorio.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_BASE_URL=https://pay.payphonetodoesposible.com
DEPOSITO_MIN=1.00
DEPOSITO_MAX=1000.00

# --- Spec 2: retiros (USD). Sobre el umbral, revisión manual del administrador. ---
RETIRO_MIN=5.00
RETIRO_MAX=1000.00
RETIRO_UMBRAL_REVISION=100.00

# Spec 4: cupones y rollover (opcionales; valores por defecto de specs/004-promociones-fraude-reportes/contracts/configuracion.md).
CUPON_ROLLOVER_MULTIPLICADOR=5
CUPON_ROLLOVER_CUOTA_MINIMA=1.50
BONO_VIGENCIA_DIAS=30
# Spec 4: umbrales de las reglas de fraude (opcionales).
FRAUDE_IP_MAX_CUENTAS=3
FRAUDE_IP_VENTANA_HORAS=24
FRAUDE_APUESTA_FACTOR=10
FRAUDE_APUESTA_HISTORIAL_MIN=5
FRAUDE_RAFAGA_MAX_APUESTAS=10
FRAUDE_RAFAGA_VENTANA_SEG=60
FRAUDE_RETIRO_VENTANA_HORAS=24
FRAUDE_RETIRO_ACTIVIDAD_MIN_PCT=50

# Spec 3: proveedor de datos deportivos. Con simulación en true no se consulta a API-Football.
API_FOOTBALL_SIMULACION=true
# Secreto: solo en el backend. Obligatoria (junto con API_FOOTBALL_LIGAS) si API_FOOTBALL_SIMULACION=false.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_PRESUPUESTO_DIARIO=100
# Ids de ligas a importar, separados por comas (p. ej. 39,140).
API_FOOTBALL_LIGAS=
# Spec 3: límites de apuestas (USD con dos decimales) y plazos.
APUESTA_MONTO_MIN=0.50
APUESTA_MONTO_MAX=500.00
APUESTA_LIMITE_DIARIO_USUARIO=1000.00
APUESTA_GANANCIA_MAX=5000.00
APUESTA_MAX_SELECCIONES=10
APUESTA_RETARDO_VIVO_MS=5000
SUSPENSION_PLAZO_HORAS=48
