# Copia este archivo a .env (nunca subas el .env). Valores para docker compose local.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://apuestas:apuestas_local@localhost:5432/apuestas
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
# Proxies de confianza delante de la API (0 en local, 1 en Render).
TRUST_PROXY_HOPS=0

# --- Spec 2: identidad y sesión ---
# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, TOTP_CLAVE_CIFRADO y WEB_PROXY_SECRETO se generan, no se copian.
# Desde la raíz del repo (agrega las cuatro líneas al final de este .env):
#   pnpm --filter api exec tsx scripts/generar-secretos.ts >> apps/api/.env
# WEB_PROXY_SECRETO debe ser el mismo en apps/web/.env.local.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# En local por HTTP; en staging y producción siempre true.
COOKIE_SECURE=false
# Secreto de prueba de Cloudflare Turnstile: aprueba siempre. Nunca en producción.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15

# --- Spec 2: correo (Mailpit de docker compose; bandeja en http://localhost:8025) ---
CORREO_TRANSPORTE=smtp
SMTP_URL=smtp://localhost:1025
CORREO_REMITENTE=Apuestas <no-responder@localhost>
