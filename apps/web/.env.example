# Copia este archivo a .env.local (nunca lo subas). Las dos URLs se usan solo desde el servidor de Next.js.
# Nada con secretos lleva el prefijo NEXT_PUBLIC_: todo lo que lo lleve llega al navegador.
API_URL=http://localhost:3001
REPORTS_URL=http://localhost:8000
# Spec 3: gateway de tiempo real (Socket.IO). No es secreto: llega al navegador.
NEXT_PUBLIC_WS_URL=http://localhost:3001
