{
  "name": "apuestasdeportivas",
  "private": true,
  "description": "Sistema web de apuestas deportivas (proyecto académico UTPL)",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter api exec prisma migrate deploy",
    "reports:install": "uv sync --directory apps/reports",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "turbo": "2.11.11"
  }
}
